{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#ffffff" },
      "foreground": { "$value": "#111111" },
      "border": { "$value": "#eeeeee" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#111111" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#111111" },
      "primary": {
        "$value": "#000000",
        "$description": "Black is the primary action and emphasis color in the light New Models interface."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f4f4f5" },
      "secondaryForeground": { "$value": "#27272a" },
      "muted": { "$value": "#f4f4f5" },
      "mutedForeground": { "$value": "#a1a1aa" },
      "accent": {
        "$value": "#1daaf9",
        "$description": "The blue used for New Models links and Discord message links."
      },
      "accentForeground": { "$value": "#07131b" },
      "destructive": { "$value": "#d00000" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#eeeeee" },
      "ring": { "$value": "#1daaf9" },
      "chart1": { "$value": "#1daaf9" },
      "chart2": { "$value": "#111111" },
      "chart3": { "$value": "#71717a" },
      "chart4": { "$value": "#facc15" },
      "chart5": { "$value": "#d00000" },
      "sidebar": { "$value": "#fafafa" },
      "sidebarForeground": { "$value": "#3f3f46" },
      "sidebarBorder": { "$value": "#eeeeee" },
      "sidebarPrimary": { "$value": "#000000" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#f4f4f5" },
      "sidebarAccentForeground": { "$value": "#27272a" },
      "sidebarRing": { "$value": "#1daaf9" }
    },
    "dark": {
      "background": { "$value": "#36393f" },
      "foreground": { "$value": "#f4f4f5" },
      "border": { "$value": "#2b2d31" },
      "card": { "$value": "#2b2d31" },
      "cardForeground": { "$value": "#f4f4f5" },
      "popover": { "$value": "#2b2d31" },
      "popoverForeground": { "$value": "#f4f4f5" },
      "primary": {
        "$value": "#748bd9",
        "$description": "The periwinkle submit action from the New Models Discord mode."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#40454b" },
      "secondaryForeground": { "$value": "#f4f4f5" },
      "muted": { "$value": "#2b2d31" },
      "mutedForeground": { "$value": "#d1d5db" },
      "accent": { "$value": "#1daaf9" },
      "accentForeground": { "$value": "#07131b" },
      "destructive": { "$value": "#7f1d1d" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#40454b" },
      "ring": { "$value": "#748bd9" },
      "chart1": { "$value": "#1daaf9" },
      "chart2": { "$value": "#748bd9" },
      "chart3": { "$value": "#a1a1aa" },
      "chart4": { "$value": "#facc15" },
      "chart5": { "$value": "#f87171" },
      "sidebar": { "$value": "#2b2d31" },
      "sidebarForeground": { "$value": "#f4f4f5" },
      "sidebarBorder": { "$value": "#40454b" },
      "sidebarPrimary": { "$value": "#748bd9" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#40454b" },
      "sidebarAccentForeground": { "$value": "#f4f4f5" },
      "sidebarRing": { "$value": "#748bd9" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Helvetica", "sans-serif"],
        "$description": "The global New Models interface uses the system Helvetica stack."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "The source uses compact Tailwind rounded corners, with pills reserved for circular counters."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
